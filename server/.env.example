# Copy this file to .env and fill it in. The server refuses to start without ACCESS_TOKEN.

# Shared secret the iPad app sends as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
ACCESS_TOKEN=

# Model for /generate. Any provider and model pi-ai knows works; the model must read images.
MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-5-5

# The API key goes in the provider's own variable, for example
# ANTHROPIC_API_KEY, OPENAI_API_KEY or GEMINI_API_KEY.
ANTHROPIC_API_KEY=

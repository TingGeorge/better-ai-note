# Copy this file to .env and fill it in. The server refuses to start without ACCESS_TOKEN.

# Shared secret the iPad app sends as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
ACCESS_TOKEN=

# Speech-to-text for voice input. Any OpenAI-compatible /audio/transcriptions API works.
# Leave these empty to turn voice input off; POST /transcribe then answers 503.
# OpenAI:              STT_BASE_URL=https://api.openai.com/v1   STT_MODEL=whisper-1
# Groq:                STT_BASE_URL=https://api.groq.com/openai/v1   STT_MODEL=whisper-large-v3-turbo
# Self-hosted Whisper: STT_BASE_URL=http://localhost:8000/v1   (model name depends on the server)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
